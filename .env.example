# Public shell runs without a backend. Configure both values in Phase 1.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Trusted origin for authentication callbacks; production must use HTTPS.
APP_URL=http://localhost:3000
# Never enables fabricated predictions. Model integration is deferred.
PREDICTIONS_ENABLED=false
SPORTS_DATA_PROVIDER=demo

# Enable only after configuring Google OAuth in the same Supabase project.
GOOGLE_OAUTH_ENABLED=false
